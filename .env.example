# =============================================================================
# Copy to .env.local and fill in. Nothing here is a real secret.
#
# STANDING THIS UP FOR A SECOND BUSINESS? The BRANDING block is what makes this
# codebase a different shop. Read the two ⚠️ notes there before you deploy.
# =============================================================================

# ---- Shopify (the datastore) ------------------------------------------------
# Either a static Admin API token, OR client credentials. Not both.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_CURRENCY=GBP

# ---- Auth -------------------------------------------------------------------
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ⚠️ REQUIRED FOR A NEW BUSINESS. Comma-separated accounts with permanent full
# access to the portal. Leave this unset and the previous business's owners keep
# owner access to your data — see lib/brand.ts.
PORTAL_OWNER_EMAIL=owner@yourbusiness.com

# Signs trade-login cookies, public invoice/statement links, and doubles as the
# master admin password. Long and random.
PORTAL_SESSION_SECRET=generate-something-long-and-random

# ---- Branding ---------------------------------------------------------------
# Shown on screen, on invoices and in PDFs. The owner can also edit most of these
# from the Settings page; these are the values used before anything is saved.
NEXT_PUBLIC_BIZ_NAME=YOUR BUSINESS
NEXT_PUBLIC_BIZ_TAGLINE=What you sell — Wholesale
# Pipe-separated, one address line per segment.
NEXT_PUBLIC_BIZ_ADDRESS=Unit 1, Example Road|London|SW1A 1AA|United Kingdom
NEXT_PUBLIC_BIZ_EMAIL=hello@yourbusiness.com
NEXT_PUBLIC_BIZ_PHONE=
NEXT_PUBLIC_BIZ_WEBSITE=yourbusiness.com
NEXT_PUBLIC_BIZ_VAT=
NEXT_PUBLIC_BIZ_BANK=

# Filesystem-safe token used in generated filenames:
#   <slug>-catalog-2026-07-28.xlsx, <slug>-backup-….json
NEXT_PUBLIC_BRAND_SLUG=yourbusiness

# Starting invoice-number prefix -> ABC-2026-0001 (overridable in Settings).
NEXT_PUBLIC_BRAND_INVOICE_PREFIX=ABC

# ⚠️ REQUIRED IF TWO DEPLOYMENTS SHARE A BROWSER. Namespaces every localStorage
# key. Leave it unset on a second site and the two shops share one shopping cart
# and one "already sent today" list.
NEXT_PUBLIC_BRAND_STORAGE=yourbusiness

# Public copy of the store domain — client components (the Channels board, the
# product editor's "View" link) can't read the server-only SHOPIFY_STORE_DOMAIN.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Product categories in the product editor. Comma-separated; omit for the
# default phone/laptop-parts list.
# NEXT_PUBLIC_PRODUCT_TYPES=Screens,Batteries,Cables,Chargers,Cases

# Canonical public URL — used to build shareable invoice/statement links.
NEXT_PUBLIC_SITE_URL=https://store.yourbusiness.com

# ---- Messaging --------------------------------------------------------------
# Email via resend.com. Without a verified domain, Resend's test sender only
# delivers to your own account address.
RESEND_API_KEY=
EMAIL_FROM=YOUR BUSINESS <invoices@yourbusiness.com>

# WhatsApp Cloud API credentials are NOT set here — the owner enters them on the
# Settings page, and they're stored in a separate metafield so staff can't read
# the token through /api/settings.

# ---- Scheduled jobs ---------------------------------------------------------
# Bearer token Vercel Cron sends to /api/cron/daily-digest. If unset, the route
# falls back to trusting the vercel-cron user-agent.
CRON_SECRET=

# ---- Optional feature flags -------------------------------------------------
# Staff time-clock (tap in / tap out). Off by default; the owner's "Require tap
# in" setting does nothing until this is 1.
# ENABLE_TAPIN=1

# Include on-account (ledger) payments in the dashboard's "Collected today".
# Off by default because it scans every customer's ledger and was a source of lag.
# ENABLE_LEDGER_TODAY=1
